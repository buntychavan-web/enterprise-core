# EWOS frontend (enterprise-core) — build-time environment variables.
# Vite only exposes vars prefixed VITE_ to client code; all of these are
# baked in at build time, not read at runtime.

# Demo Login — Development/Test builds only. The vite.config.ts build guard
# hard-fails a `mode: production` build if this is left "true", so it cannot
# ship to production even by accident. See src/lib/feature-flags.ts.
VITE_ENABLE_DEMO_LOGIN=false

# ---- CI-only (private package registry) -------------------------------------
# This app depends on @lovable.dev/* packages published to a private
# registry. `bun install` needs these to resolve them — see
# .github/workflows/ci.yml and docs/DEPLOYMENT.md. Not consumed by the app
# itself, so not a VITE_ var.
# BUN_CONFIG_REGISTRY=
# BUN_CONFIG_TOKEN=
